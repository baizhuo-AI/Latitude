[Unit]
Description=Latitude Domain Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=apple
Group=apple
WorkingDirectory=/opt/latitude/current
Environment=LATITUDE_DOMAIN_ADDR=127.0.0.1:43121
Environment=LATITUDE_DB_PATH=/var/lib/latitude/domain/latitude-domain.db
Environment=LATITUDE_BACKUP_DIR=/var/lib/latitude/domain/backups
Environment=LATITUDE_WEB_ORIGIN=https://latitude.baizhuo.online
Environment=LATITUDE_WEB_PORT=1420
Environment=RUST_LOG=latitude_domain_service=info
ExecStart=/opt/latitude/current/bin/latitude-domain
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/latitude
UMask=0077

[Install]
WantedBy=multi-user.target
