{
  "name": "latitude",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "dev:agent": "node --env-file-if-exists=.env.local --import tsx services/agent/src/index.ts",
    "dev:domain": "node --env-file-if-exists=.env.local scripts/dev-domain.mjs",
    "dev:local": "node --env-file-if-exists=.env.local scripts/dev-local.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "doctor:local": "node --env-file-if-exists=.env.local scripts/doctor-local.mjs",
    "accept:browser": "node scripts/accept-browser.mjs",
    "accept:offline": "node scripts/accept-offline.mjs",
    "accept:local": "node --env-file-if-exists=.env.local scripts/accept-local.mjs",
    "test:browser-smoke": "node --test scripts/browser-cdp.node-test.mjs scripts/accept-browser.node-test.mjs scripts/accept-offline.node-test.mjs scripts/seed-demo.node-test.mjs",
    "scan:artifacts": "node scripts/scan-credential-artifacts.mjs",
    "verify:code": "node scripts/verify-code.mjs",
    "typecheck:agent": "tsc -p services/agent/tsconfig.json --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "ladle": "ladle serve --host 127.0.0.1 --port 61000",
    "ladle:build": "ladle build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-loop": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-web": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-web": "0.1.0-rc.6",
    "@deepseek-ai/dsh-web-search-deepseek": "0.1.0-rc.6",
    "@dnd-kit/core": "^6.3.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "clsx": "^2.1.1",
    "i18next": "^26.0.10",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@ladle/react": "^5.1.1",
    "@tauri-apps/cli": "^2.11.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "jsdom": "^29.1.0",
    "postcss": "^8.5.12",
    "stylelint": "^17.9.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^3.4.19",
    "tsx": "4.20.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
