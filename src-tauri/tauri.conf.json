{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Latitude",
  "version": "0.1.0",
  "identifier": "com.latitude.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/build-native-runtime.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "backgroundThrottling": "disabled",
        "title": "Latitude",
        "width": 1100,
        "height": 740,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "center": true
      },
      {
        "label": "chatbar",
        "title": "Latitude · 对话",
        "url": "/index.html#/__pet_chat__",
        "width": 420,
        "height": 460,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "focus": false,
        "acceptFirstMouse": true,
        "center": false,
        "x": 360,
        "y": 640
      },
      {
        "label": "todo",
        "create": false,
        "title": "Latitude · 待办",
        "url": "/index.html#/__todo__",
        "width": 280,
        "height": 440,
        "minWidth": 240,
        "minHeight": 320,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "center": false,
        "x": 1140,
        "y": 80
      },
      {
        "label": "launcher",
        "create": false,
        "title": "Latitude",
        "url": "/index.html#/__launcher__",
        "width": 48,
        "height": 48,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "center": false,
        "x": 40,
        "y": 700
      },
      {
        "label": "pet",
        "backgroundThrottling": "disabled",
        "title": "维度秘书",
        "url": "/index.html#/__pet__",
        "width": 220,
        "height": 260,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true,
        "closable": false
      },
      {
        "label": "pet-notice",
        "title": "维度秘书提醒",
        "url": "/index.html#/__pet_notice__",
        "width": 340,
        "height": 180,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true,
        "closable": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/agent/": "agent/"
    }
  }
}
