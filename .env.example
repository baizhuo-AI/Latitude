# Latitude 环境变量模板
# 复制为 `.env.local`,填入你的 key。.env.local 已被 .gitignore 排除。

# Browser only keeps non-secret presentation flags. Model credentials belong
# to the local Agent Host and are never exposed through Vite.
VITE_LLM_PROVIDER=local-agent

# 浏览器开发固定进入真实本地服务产品面；旧工作台只在 Tauri 壳内保留。

# DeepSeek (read only by `npm run dev:agent`)
DEEPSEEK_API_KEY=
# Chat Completions 与 Harness Web Search 使用不同的官方兼容端点。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional additional model providers. After configuring a key, choose the
# provider and model from the Browser product's Settings dialog.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6

# Local service addresses. They listen on loopback only.
LATITUDE_WEB_PORT=1420
# Optional exact HTTPS Browser origin for an authenticated reverse-proxy deployment.
# LATITUDE_WEB_ORIGIN=https://latitude.example.com
LATITUDE_AGENT_PORT=43120
LATITUDE_DOMAIN_ADDR=127.0.0.1:43121
LATITUDE_DOMAIN_URL=http://127.0.0.1:43121
LATITUDE_STATE_DIR=.latitude/agent
LATITUDE_DB_PATH=.latitude/latitude-domain.db
# Business outputs, separate from the knowledge graph. On macOS the default is
# ~/Library/Application Support/com.latitude.desktop/latitude.db (existing app data).
# Set an explicit absolute path for isolated test/demo profiles; never point at the graph DB.
# LATITUDE_DESKTOP_DB_PATH=/absolute/path/to/latitude.db
LATITUDE_BACKUP_DIR=.latitude/backups

# Optional override for `npm run sync:computer-history`. On macOS the importer
# auto-detects the standard local Skysight root when this is empty.
LATITUDE_COMPUTER_HISTORY_ROOT=
