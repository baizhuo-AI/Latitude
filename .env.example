# Latitude 环境变量模板
# 复制为 `.env.local`,填入你的 key。.env.local 已被 .gitignore 排除。

# Browser only keeps non-secret presentation flags. Model credentials belong
# to the local Agent Host and are never exposed through Vite.
VITE_LLM_PROVIDER=local-agent

# 浏览器开发固定进入真实本地服务产品面；旧工作台只在 Tauri 壳内保留。

# DeepSeek (read only by `npm run dev:agent`)
DEEPSEEK_API_KEY=
# Chat Completions 与 Harness Web Search 使用不同的官方兼容端点。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# Local service addresses. They listen on loopback only.
LATITUDE_WEB_PORT=1420
# Optional exact HTTPS Browser origin for an authenticated reverse-proxy deployment.
# LATITUDE_WEB_ORIGIN=https://latitude.example.com
LATITUDE_AGENT_PORT=43120
LATITUDE_DOMAIN_ADDR=127.0.0.1:43121
LATITUDE_DOMAIN_URL=http://127.0.0.1:43121
LATITUDE_STATE_DIR=.latitude/agent
LATITUDE_DB_PATH=.latitude/latitude-domain.db
LATITUDE_BACKUP_DIR=.latitude/backups
